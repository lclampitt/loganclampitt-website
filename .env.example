# Names only, never values. Real values live in Vercel → Project →
# Settings → Environment Variables (Production and Preview), set by Logan.
# For `npm run dev`, Logan copies this to .env.local (gitignored) and
# fills it in. None of these may be VITE_ variables: Vite ships those to
# the browser.

# api/events.js and api/console/*
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# (SUPABASE_SECRET_KEY is read instead if SUPABASE_SERVICE_ROLE_KEY is missing)

# api/console/*: the one address allowed to sign in to /console
CONSOLE_EMAIL=
